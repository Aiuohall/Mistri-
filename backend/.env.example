# Server
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:8081,http://localhost:3001
# Swagger is enabled outside production. Set ENABLE_SWAGGER=true only when production docs
# are intentionally protected by your deployment controls.
ENABLE_SWAGGER=true

# Local Postgres/PostGIS. Set DATABASE_SSL=true for Supabase.
DATABASE_URL=postgresql://mistri:change-me-for-local-development@127.0.0.1:5433/mistri
DATABASE_SSL=false

# Supabase project URL. The backend derives its public JWKS URL from this value.
# Never add a Supabase service-role key to the mobile app or this file.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable-your-publishable-key
SUPABASE_JWT_AUDIENCE=authenticated

## Test money only. Applies to newly created requests in development and test.
MISTRI_WALLET_SANDBOX=false
MISTRI_TEST_COMMISSION_BPS=1000
